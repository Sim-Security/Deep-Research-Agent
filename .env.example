# Deep Research Agent - Environment Variables

# =============================================================================
# LLM PROVIDERS (via OpenRouter for model flexibility)
# =============================================================================
# Get your OpenRouter API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Or use direct provider keys (optional, OpenRouter is preferred)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# SEARCH APIs
# =============================================================================
# DuckDuckGo: No API key needed (free, used during development)
# Tavily: Get your API key at https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Default search provider: "duckduckgo" (free) or "tavily" (production)
DEFAULT_SEARCH_API=duckduckgo

# =============================================================================
# OBSERVABILITY - LangSmith
# =============================================================================
# Get your LangSmith API key at: https://smith.langchain.com/
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=deep-research-agent

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================
# Default models (OpenRouter format: provider/model-name)
# Recommended: x-ai/grok-4.1-fast (fast, high quality, good value)
# Alternatives: anthropic/claude-sonnet-4, openai/gpt-4o, google/gemini-2.0-flash
SUMMARIZATION_MODEL=x-ai/grok-4.1-fast
RESEARCH_MODEL=x-ai/grok-4.1-fast
COMPRESSION_MODEL=x-ai/grok-4.1-fast
FINAL_REPORT_MODEL=x-ai/grok-4.1-fast

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================
MAX_RESEARCHER_ITERATIONS=6
MAX_CONCURRENT_RESEARCH_UNITS=5
MAX_REACT_TOOL_CALLS=10
